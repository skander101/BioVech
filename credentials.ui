     <property name="styleSheet">
      <string notr="true">QWidget#create_account_page {
    border-image: url(&quot;:/Static/Static/white_bg.jpg&quot;) 0 0 0 0 stretch stretch; /* Use your actual background path */
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
}

/* White form card */
QWidget#whiteCard {
    background: white;
    border-radius: 20px;
    padding: 80px; /* Increased padding */
    max-width: 480px; /* Adjusted max width */
    min-width: 500px;
min-hight:800px;
}

/* Logo */
QLabel#biovec_logo {
    min-width: 90px; max-width:300px; /* Adjusted size */
    min-height:80px; max-height: 120px;
    border-image: url(&quot;:/Static/Static/logo.png&quot;) 0 0 0 0 stretch stretch;

    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
    margin-bottom: 15px; /* Space below logo */
    qproperty-alignment: 'AlignCenter'; /* Center logo */
}

/* Titles and Labels */
QLabel#formTitleLabel { /* New ID for &quot;Create your Free Account&quot; */
    font-size: 20px;
    font-weight: bold;
    color: #333;
    margin-bottom: 25px; /* Space below title */
    qproperty-alignment: 'AlignCenter';
}
QLabel { /* Default label style (e.g., &quot;Full Name&quot;, &quot;Email&quot;) */
    font-size: 12px;
    color: #555;

}

/* Input Fields */
QLineEdit {
    background: #f0f2f5; /* Lighter grey background */
    border-radius: 15px; /* Slightly smaller radius */
    border: 1px solid #e0e2e7; /* Subtle border */
    padding: 0px 5px;
    font-size: 14px;
    color: #333;
    min-height: 30px; /* Ensure height */
 /* Space below input */
}
QLineEdit::placeholder {
    color: #888;
    font-size: 14px;
}

/* Buttons */
QPushButton#create_account_button {
    background: #1E8F53;
    border-radius: 20px;
    padding: 12px;
    font-size: 16px;
    font-weight: bold;
    color: white;
    min-height: 40px;
    margin-top: 10px; /* Space above button */
    margin-bottom: 20px; /* Space below button */
}
QPushButton {
background-color: #32cc77;
    border-radius: 20px;
    font-size: 16px;
    padding: 5px;
    font-weight: bold;
    color: white;
    min-height: 30px;

}
QPushButton#create_account_button:hover {
    background: #17663D;
}
QPushButton:hover {
    background: #2baf66;
}

/* Google/GitHub Buttons */
QPushButton#googleButton, QPushButton#githubButton {
    background-color: white;
    border-radius: 12px;
    padding: 10px;
    font-weight: normal; /* Normal weight */
    font-size: 14px;
    color: #555;
    border: 1px solid #ddd;
    min-height: 40px;
    text-align: center; /* Center text */
}
QPushButton#googleButton:hover, QPushButton#githubButton:hover {
    background: #f8f8f8;
}

/* Switch Button (Log In) */
QPushButton#switch_login_butt {
    color: #1E8F53; /* Use theme color */
    font-size: 14px;
    border: none;
    background: transparent;
    padding: 5px;
    text-decoration: none; /* Remove underline if any */
}
QPushButton#switch_login_butt:hover {
    font-weight: bold;
    text-decoration: underline;
}

/* OR Label */
QLabel#orLabel { /* Give the &quot;OR&quot; label an ID */
    color: #aaa;
    font-size: 13px;
    qproperty-alignment: 'AlignCenter';
    margin-top: 15px;
    margin-bottom: 15px;
}

/* Decorative Text Container */
QWidget#WordContainer QLabel { /* Style labels inside the text container */
    font-size: 55px;
    font-weight: bold;
    color: #1E8F53; /* Match button green */
    margin-bottom: 5px;
    qproperty-alignment: 'AlignCenter';
}

QSpinBox {
    background: #f0f2f5; /* Lighter grey background */
    border-radius: 18px; /* Slightly smaller radius */
    border: 1px solid #e0e2e7; /* Subtle border */
    padding: 0px 5px;
    font-size: 14px;
    color: #333;
    min-height: 35px; /* Ensure height */
    margin-bottom: 15px; /* Space below input */
}

QDoubleSpinBox {
    background: #f0f2f5; /* Lighter grey background */
    border-radius: 18px; /* Slightly smaller radius */
