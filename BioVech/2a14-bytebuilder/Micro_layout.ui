  <property name="styleSheet">
   <string notr="true">/* Global Window Style */
QMainWindow {
 border-image: url(&quot;:/Static/Static/white_bg.jpg&quot;);
 background-size: contain;
}

/* Header Logo */
QLabel#biovec_logo {
    margin-left: 25px;
    min-width: 50px;
    max-width: 250px;
    min-height: 80px;
    max-height: 80px;
    qproperty-alignment: AlignCenter;
    background-color: transparent;
    image: url(:/Static/Static/logo.png);
}

/* Sidebar Dock Widget */
QDockWidget {
    border: none;
    background-color: #ffffff;
}

QDockWidget::title {
    background-color: #208c54;
    color: white;
    padding: 10px;
    font-weight: bold;
    border-radius: 5px;
    text-align: left;
}

/* Sidebar Header Logo */
QLabel#sidebar_top_logo {
    min-width: 50px;
    max-width: 250px;
    min-height:100px;
    max-height: 150px;
    qproperty-alignment: 'AlignCenter';
    image: url(:/Static/Static/dashboard.png);
}

/* Sidebar Button Styles - TEXT MADE LARGER */
QDockWidget QPushButton {
    background-color: #208c54;
    color: #f6f8fa;
    padding: 18px 32px 18px 25px;
    text-align: left;
    border: none;
    border-radius: 0;
    font-size: 18px;
    font-weight: bold;
}

QDockWidget QPushButton:hover {
    background-color: #27ae77;
}

QDockWidget QPushButton:pressed {
    background-color: #27ae80;
}

/* Sidebar Icon Styles - ICONS MADE LARGER */
QDockWidget QLabel {
    min-width: 60px;
    min-height:60px;
    max-width: 60px;
    max-height: 60px;
    qproperty-alignment: 'AlignCenter';
    margin-left: 4px;
}

/* GroupBox Styles - PADDING/MARGIN REDUCED */
QGroupBox {
    border: 1px solid #2ecc71;
    border-radius: 8px;
    margin-top: 12px;
    font-weight: bold;
    background-color: #ffffff;
    padding: 4px;
}

QGroupBox QPushButton {
    border-radius: 20px;
    font-weight: bold;
    padding: 10px 20px;
    min-height: 35px;
}

QGroupBox QLineEdit {
    border-radius: 20px;
    padding: 8px 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px 0 5px;
    color: #27ae60;
    background-color: #ffffff;
    border-radius: 4px;
}

/* Table Widget Styles */
QTableWidget {
    border: 1px solid #2ecc71;
    border-radius: 8px;
    alternate-background-color: #f9f9f9;
    background-color: #ffffff;
    font-size: 15px;
    selection-behavior: SelectRows;
    selection-background-color: #AFE1AF;
    selection-color: #000000;
    gridline-color: #e0e0e0;
}

QTableWidget::item:selected {
    background-color: #27ae60;
    color: white;
}

QHeaderView::section {
    background-color: #27ae60;
    color: white;
    padding: 10px;
    border: none;
    border-bottom: 1px solid #208c54;
    font-size: 16px;
    font-weight: bold;
}

/* General Button Styles */
QPushButton {
    background-color: #2ecc71;
    color: white;
    border-radius: 18px;
    padding: 10px 20px;
    font-weight: bold;
    font-size: 15px;
    min-height: 35px;
}

QPushButton:hover {
    background-color: #27ae60;
}

QPushButton:pressed {
    background-color: #1e8449;
}

/* Specific Button Styles */
QPushButton#pushButton_13 {
    background-color: #d8666c;
}

QPushButton#pushButton_13:hover {
    background-color: #d85057;
}

QPushButton#pushButton_13:pressed {
    background-color: #c04349;
}

QPushButton#pushButton_16 {
    background-color: #66ffa4;
    color: #126032;
    max-width: 40px;
    min-width: 30px;
    padding: 5px;
    font-size: 12px;
    font-weight: bold;
    min-height: 28px;
    border-radius: 5px;
}

QPushButton#pushButton_16:hover {
    background-color: #57dd8d;
}

/* Input Field Styles */
QLineEdit, QDateEdit, QComboBox, QDateTimeEdit {
    border: 1px solid #2ecc71;
    border-radius: 18px;
    padding: 8px 12px;
    background-color: #ffffff;
    font-size: 15px;
    min-height: 35px;
}

QTextEdit#lineEdit_6,
QTextEdit#lineEdit_4 {
    min-height: 100px;
    border-radius: 8px;
    qproperty-alignment: 'AlignLeft | AlignTop';
}

QTextEdit#lineEdit_4 {
    background-color: #f8f9fa;
}

/* Label Styles */
QLabel {
    color: #2c3e50;
    font-size: 15px;
    background-color: transparent;
    padding: 2px;
}

/* Main Tab Widget */
QTabWidget::pane {
    border:1px solid #2ecc71;
    border-radius: 20px 20px 20px;
    border-top: none;
    background: white;
    padding: 10px;
}

QTabBar::tab {
    background: #208c54;
    color: white;
    border: 0px solid #208c54;
    border-bottom: none;
    border-radius: 23px 23px 0 0;
    padding: 10px 20px;
    margin-right: 4px;
    font: bold 14pt &quot;Segoe UI&quot;;
    min-width: 10px;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #208c54;
    border-color: #2ecc71;
}

QTabBar::tab:!selected:hover {
    background: #1E8F53;
    color: white;
}

QTabWidget::tab-bar {
    alignment: left;
    left: 5px;
}

QCalendarWidget {
    background-color: #29aa63;
    color: #ffffff;
    font-family: &quot;Segoe UI&quot;, &quot;Arial&quot;, sans-serif;
    font-size: 16px;
    border: none;
    border-radius: 15px;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #29aa63;
    border: none;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
}

QCalendarWidget QToolButton {
    color: #ffffff;
    background-color: transparent;
    border: none;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 18px;
}

QCalendarWidget QToolButton:hover {
    background-color:#36d67e;
}

QCalendarWidget QLabel {
    font-size: 18px;
    font-weight: bold;
    color: #ffffff;
    border: none;
}

QCalendarWidget QTableView {
    background-color: #1e8c54;
    border: none;
    border-radius: 0px;
    selection-background-color: rgba(255, 255, 255, 0.3);
    selection-color: #2c3e50;
    gridStyle: none;
    font-weight: bold;
}

QCalendarWidget QTableView::item {
    border: none;
    color: white;
    border-radius: 18px;
    padding: 5px;
    qproperty-alignment: AlignCenter;
}

QCalendarWidget QTableView::item:selected {
    background-color: #81C784;
    color: white;
    border-radius: 18px;
    font-weight: bold;
}

QCalendarWidget QTableView QHeaderView::section {
    background-color: transparent;
    color: #B2DFDB;
    font-size: 16px;
    font-weight: bold;
    border: none;
    padding: 5px;
    qproperty-alignment: AlignCenter;
}

QCalendarWidget QTableView::item[dayOfWeek=&quot;6&quot;],
QCalendarWidget QTableView::item[dayOfWeek=&quot;7&quot;] {
    color: #000000;
    font-weight: bold;
}

QCalendarWidget QTableView::disabled {
    color: #66BB6A;
    font-weight: normal;
}

QCalendarWidget QAbstractItemView:focus {
    outline: none;
}</string>
