     <property name="styleSheet">
      <string notr="true">QPushButton {
    background-color: #4caf50; /* Couleur de fond (vert vif) */
    color: #ffffff; /* Couleur du texte (blanc) */
    border: 1px solid #388e3c; /* Bordure (vert foncé) */
    border-radius: 5px; /* Coins arrondis */
    padding: 5px 10px; /* Espacement interne */
    font-size: 12px; /* Taille de la police */
    font-weight: bold; /* Texte en gras */
}

QPushButton:hover {
    background-color: #66bb6a; /* Couleur de fond au survol (vert plus clair) */
    border: 1px solid #4caf50; /* Bordure au survol (vert vif) */
}

QPushButton:pressed {
    background-color: #388e3c; /* Couleur de fond lors du clic (vert foncé) */
    border: 1px solid #2e7d32; /* Bordure lors du clic (vert plus foncé) */
}

QPushButton:disabled {
    background-color: #a5d6a7; /* Couleur de fond désactivé (vert moyen) */
    color: #e8f5e9; /* Couleur du texte désactivé (vert clair) */
    border: 1px solid #81c784; /* Bordure désactivé (vert clair) */
}</string>
