    <widget class="QTableWidget" name="tableWidget">
     <property name="geometry">
      <rect>
       <x>10</x>
       <y>130</y>
       <width>631</width>
       <height>221</height>
      </rect>
     </property>
     <property name="styleSheet">
      <string notr="true">QTableWidget {
    background-color: #e8f5e9; /* Couleur de fond du tableau (vert clair) */
    alternate-background-color: #c8e6c9; /* Couleur de fond des lignes alternées (vert plus clair) */
    gridline-color: #a5d6a7; /* Couleur des lignes de la grille (vert moyen) */
    border: 1px solid #a5d6a7; /* Bordure du tableau (vert moyen) */
}

QTableWidget::item {
    padding: 5px; /* Espacement interne des cellules */
    color: #1b5e20; /* Couleur du texte (vert foncé) */
    background-color: #ffffff; /* Couleur de fond des cellules (blanc) */
}

QTableWidget::item:selected {
    background-color: #4caf50; /* Couleur de fond des cellules sélectionnées (vert vif) */
    color: #ffffff; /* Couleur du texte des cellules sélectionnées (blanc) */
}

QHeaderView::section {
    background-color: #4caf50; /* Couleur de fond des en-têtes (vert vif) */
    color: #ffffff; /* Couleur du texte des en-têtes (blanc) */
    padding: 5px; /* Espacement interne des en-têtes */
    border: 1px solid #388e3c; /* Bordure des en-têtes (vert foncé) */
}

QScrollBar:vertical {
    background-color: #e8f5e9; /* Couleur de fond de la barre de défilement verticale (vert clair) */
    width: 12px; /* Largeur de la barre de défilement verticale */
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:vertical {
    background-color: #a5d6a7; /* Couleur de la poignée de la barre de défilement verticale (vert moyen) */
    min-height: 20px; /* Hauteur minimale de la poignée */
    border-radius: 6px; /* Bordure arrondie de la poignée */
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none; /* Supprime les boutons de défilement */
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none; /* Supprime la zone de défilement */
}</string>
