    <property name="styleSheet">
     <string notr="true">QGroupBox {
    background-color: #e8f5e9; /* Couleur de fond (vert clair) */
    color: #1b5e20; /* Couleur du texte (vert foncé) */
    border: 2px solid #4caf50; /* Bordure (vert vif) */
    border-radius: 5px; /* Coins arrondis */
    padding: 10px; /* Espacement interne */
    font-size: 14px; /* Taille de la police */
    font-weight: bold; /* Texte en gras */
    margin-top: 20px; /* Espacement au-dessus du titre */
}

QGroupBox::title {
    subcontrol-origin: margin; /* Position du titre */
    subcontrol-position: top left; /* Alignement du titre */
    padding: 0 5px; /* Espacement interne du titre */
    background-color: #4caf50; /* Couleur de fond du titre (vert vif) */
    color: #ffffff; /* Couleur du texte du titre (blanc) */
    border: 1px solid #388e3c; /* Bordure du titre (vert foncé) */
    border-radius: 3px; /* Coins arrondis du titre */
}</string>
    </property>
