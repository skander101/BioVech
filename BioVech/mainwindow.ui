     <property name="styleSheet">
      <string notr="true">QLineEdit {
    background-color: #e8f5e9; /* Couleur de fond (vert clair) */
    color: #1b5e20; /* Couleur du texte (vert foncé) */
    border: 1px solid #a5d6a7; /* Bordure (vert moyen) */
    border-radius: 5px; /* Coins arrondis */
    padding: 5px; /* Espacement interne */
    font-size: 12px; /* Taille de la police */
    selection-background-color: #4caf50; /* Couleur de fond du texte sélectionné (vert vif) */
    selection-color: #ffffff; /* Couleur du texte sélectionné (blanc) */
}

QLineEdit:focus {
    border: 2px solid #4caf50; /* Bordure plus épaisse et verte vif lorsqu'en focus */
}

QLineEdit:disabled {
    background-color: #c8e6c9; /* Couleur de fond désactivé (vert plus clair) */
    color: #81c784; /* Couleur du texte désactivé (vert moyen) */
    border: 1px solid #a5d6a7; /* Bordure désactivé (vert moyen) */
}</string>
