  <property name="styleSheet">
   <string notr="true">QWidget #background_login {
    border-image: url(&quot;:/Static/Static/white_bg.jpg&quot;)  0 0 0 0 stretch stretch ;
  background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
position: absolute; /* Ensures fixed positioning */
    right: 5%; /* Keeps it to the right with margin */
    top: 50%;
    transform: translateY(-50%); /* Centers vertically */
    width: 40%; 
}QWidget #whiteCard {
    /*	background: rgba(255, 255, 255, 0.9); /* Semi-transparent white */
    background: white;
    border-radius: 20px;
    padding: 30px;
    position: absolute; /* Ensures fixed positioning */
    right: 5%; /* Keeps it to the right with margin */
    top: 50%;
    transform: translateY(-50%); /* Centers vertically */
    width: 40%; /* Adjust width as needed */
}
QLabel#biovec_logo {
	border-image: url(&quot;:/Static/Static/logo.png&quot;)0 0 0 0 stretch stretch ;
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
}

/* Title */
QLabel#titleLabel {
    font-size: 50px;
    font-weight: bold;
    color: #00703c;
}

QLabel#subtitleLabel2_3 {
    font-size: 35px;
    color: #00703c;
    font-weight: bold
}
QLabel#subtitleLabel2_4 {
    font-size: 35px;
    color: #00703c;
}

QLabel#subtitleLabel1 {
    font-size: 35px;
    font-weight: bold;
    color: #00703c;
}
QLabel#subtitleLabel2 {
    font-size: 35px;
    color: #00703c;
}

/* Input fields */
QLineEdit {
    background: rgba(176, 186, 195, 0.4); /* Same as 66B0BAC3 */
    border-radius: 20px;
    border: 0px;
    padding: 15px;
    font-size: 12px;
    color: #7C838A;
}

/* Placeholder text */
QLineEdit::placeholder {
    color: #7C838A;
    font-size: 18px;
}

/* Main button */
QPushButton#Sign_in {
    background: #1E8F53;
    border-radius: 20px;
    padding: 15px;
    font-size: 16px;
    font-weight: bold;
    color: white;
}

/* Hover effect */
QPushButton#Sign_in:hover {
    background: #17663D;
}

/* Social login buttons */
QPushButton#googleButton, QPushButton#githubButton {
	background-color: rgb(72, 72, 72);
    border-radius: 20px;
    padding: 6px;
    background: white;
}

QPushButton#googleButton:hover, QPushButton#githubButton:hover {
    background: #f2f2f2;
}

</string>
