  <property name="styleSheet">
   <string notr="true">/* Global Window Style */
QMainWindow {
 border-image: url(&quot;:/Static/Static/white_bg.jpg&quot;);
 background-size: contain;
}
/* Header Logo (Adjusted Size Constraints) */
QLabel#biovec_logo {
    margin-left: 25px; /* Keep margin */
    min-width: 50px;
    max-width: 250px;
    min-height: 80px;
    max-height: 80px;
    qproperty-alignment: AlignCenter;
    background-color: transparent;
    image: url(:/Static/Static/logo.png);
}

/* Sidebar Dock Widget */
QDockWidget {
    border: none;
    background-color: #ffffff;
}

QDockWidget::title {
    background-color: #208c54;
    color: white;
    padding: 10px;
    font-weight: bold;
    border-radius: 5px;
    text-align: left;
}

/* Sidebar Header Logo */
QLabel#label_logo {

    min-width: 50px;
    max-width: 250px;
    min-height:100px;
    max-height: 150px;
    qproperty-alignment: 'AlignCenter';
    image: url(:/Static/Static/dashboard.png);

}

/* Sidebar Button Styles - TEXT MADE LARGER */
QDockWidget QPushButton {
    background-color: #208c54;
    color: #f6f8fa;
   padding: 18px 32px 18px 25px; /* Slightly increased vertical padding */
    text-align: left;
    border: none;
    border-radius: 0;
    font-size: 18px;  /* INCREASED FONT SIZE */
    font-weight: bold;
}

QDockWidget QPushButton:hover {
    background-color: #27ae77;
}

QDockWidget QPushButton:pressed {
    background-color: #27ae80;
}

/* Sidebar Icon Styles - ICONS MADE LARGER */
QDockWidget QLabel { /* Selects icons within the DockWidget */
    min-width: 60px;   /* INCREASED ICON SIZE */
    min-height:60px;  /* INCREASED ICON SIZE */
    max-width: 60px;   /* INCREASED ICON SIZE */
    max-height: 60px;  /* INCREASED ICON SIZE */
    qproperty-alignment: 'AlignCenter';
         margin-left: 4px;
}

/* GroupBox Styles - PADDING/MARGIN REDUCED */
QGroupBox {
    border: 1px solid #2ecc71;
    border-radius: 8px;
    margin-top: 12px; /* REDUCED margin-top slightly */
    font-weight: bold;
    background-color: #ffffff;
    padding: 4px; /* REDUCED padding inside the groupbox */
}
QGroupBox QPushButton{
    border-radius:20px; /* Adjusted to match general button radius */
    font-weight: bold;
    padding: 10px 20px; /* Adjusted padding to match general buttons */
    font-size: 15px; /* Match general button font size */
    min-height: 35px; /* Match general button height */
}

QGroupBox QLineEdit, QGroupBox QSpinBox, QGroupBox QDoubleSpinBox { /* Added SpinBox styling */
    border: 1px solid #2ecc71;
    border-radius: 18px; /* Match general input radius */
    padding: 8px 12px; /* Match general input padding */
    background-color: #ffffff;
    font-size: 15px; /* Match general input font size */
    min-height: 35px; /* Match general input height */
}


QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px 0 5px;
    color: #27ae60;
    background-color: #ffffff;
    border-radius: 4px;
}

/* Table Widget Styles */
QTableWidget {
    border: 1px solid #2ecc71;
    border-radius: 8px;
    alternate-background-color: #f9f9f9;
    background-color: #ffffff;
    font-size: 15px;
    selection-behavior: SelectRows;
    selection-background-color: #AFE1AF;
    selection-color: #000000;
    gridline-color: #e0e0e0;
}

QTableWidget::item { /* Added item alignment from original personnel */
  text-align: center;
  padding-top: 5px;
  padding-bottom: 5px;
}

QTableWidget::item:selected {
    background-color: #27ae60;
    color: white;
}

QHeaderView::section {
    background-color: #27ae60;
    color: white;
    padding: 10px; /* Adjusted padding */
    border: none;
    border-bottom: 1px solid #208c54;
    font-size: 16px;
    font-weight: bold;
}

/* General Button Styles */
QPushButton {
    background-color: #2ecc71;
    color: white;
    border-radius: 18px;
    padding: 10px 20px;
    font-weight: bold;
    font-size: 15px;
    min-height: 35px;
}

QPushButton:hover {
    background-color: #27ae60;
}

QPushButton:pressed {
    background-color: #1e8449;
}

/* Specific Button Styles */
QPushButton#pushButton_delete { /* Kept original personnel delete style for difference */
    background-color: #e74c3c;
    color: white;
}
QPushButton#pushButton_delete:hover {
    background-color: #c0392b;
}
QPushButton#pushButton_delete:pressed {
    background-color: #a93226;
}

QPushButton#pushButton_clear { /* Kept original personnel clear style for difference */
   background-color: #95a5a6;
   color: white;
}
QPushButton#pushButton_clear:hover {
    background-color: #7f8c8d;
}
QPushButton#pushButton_clear:pressed {
    background-color: #6c7a7d;
}

/* Input Field Styles */
QLineEdit, QDateEdit, QComboBox, QSpinBox, QDoubleSpinBox { /* Added SpinBox/DoubleSpinBox */
    border: 1px solid #2ecc71;
    border-radius: 18px;
    padding: 8px 12px;
    background-color: #ffffff;
    font-size: 15px;
    min-height: 35px;
}

/* Specific SpinBox styling if needed */
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 16px;
    border-image: url(:/qt-project.org/styles/commonstyle/images/spinup-16x16.png); /* Example icon */
    border-width: 1px;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 16px;
    border-image: url(:/qt-project.org/styles/commonstyle/images/spindown-16x16.png); /* Example icon */
    border-width: 1px;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #e0e0e0;
}


/* Label Styles */
QLabel {
    color: #2c3e50;
    font-size: 15px; /* Adjusted font size */
    background-color: transparent;
    padding: 2px;
}
/* Align specific labels from personnel form if needed */
QLabel#idLabel, QLabel#NomLabel, QLabel#PrenomLabel, QLabel#AgeLabel, QLabel#SalaireLabel, QLabel#PosteLabel, QLabel#AssuranceLabel, QLabel#PasswordLabel {
    qproperty-alignment: 'AlignRight | AlignVCenter'; /* Keep right alignment for form labels */
    padding-right: 5px; /* Add some padding */
}


/* Main Tab Widget */
QTabWidget::pane {
    border:1px solid #2ecc71;
    border-radius: 20px 20px 20px;
    border-top: none;
    background: white;
    padding: 10px;
}

QTabBar::tab {
    background: #208c54;
    color: white;
    border: 0px solid #208c54;
    border-bottom: none;
    border-radius: 23px 23px 0 0;
    padding: 10px 20px;
    margin-right: 4px;
    font: bold 14pt &quot;Segoe UI&quot;;
    min-width: 10px;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #208c54;
    border-color: #2ecc71;
}

QTabBar::tab:!selected:hover {
    background: #1E8F53;
    color: white;
}

QTabWidget::tab-bar {
    alignment: left;
    left: 5px;
}

/* Calendar styles are kept from appointment UI but won't be used unless a calendar is added */
QCalendarWidget {
    /* Background Color */
    background-color: #29aa63;
    color: #ffffff; /* White text */
    font-family: &quot;Segoe UI&quot;, &quot;Arial&quot;, sans-serif;
    font-size: 16px;
    border: none;
    border-radius: 15px; /* Rounded corners */
}
/* ... (rest of the calendar styles from appointment.ui) ... */
